.venv/
.tmp/
__pycache__/
.pytest_cache/
/work/
/output/

# Generated PSD files are private by default.
*.psd

# Only these reviewed example files are public. Ignore any future work files
# placed under examples/ until they are deliberately added to this allowlist.
/examples/*
!/examples/reference.jpg
!/examples/output/
/examples/output/*
!/examples/output/output.psd

# User-provided illustrations and line art (never publish by default)
/input/

# Sample-specific semantic plans and generated runtime state
docs/active_job.json
docs/jobs/
docs/PREVIEW.md
docs/PROGRESS.md
docs/RESUME.md

# Test and tool by-products
.coverage
htmlcov/
*.py[cod]
